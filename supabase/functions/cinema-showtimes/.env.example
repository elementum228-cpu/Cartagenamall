# Secretos de la función `cinema-showtimes` (se cargan con `supabase secrets set NOMBRE=valor`; nunca se suben al repositorio).
# Solo se llenan las cadenas que ya tienen un feed AUTORIZADO; las demás salen «Horarios no disponibles temporalmente».

# Cine Colombia
CINEMA_CINECOLOMBIA_FEED_URL=
CINEMA_CINECOLOMBIA_FEED_TOKEN=
# CINEMA_CINECOLOMBIA_OFFICIAL_URL=
# CINEMA_CINECOLOMBIA_HOSTS=

# Procinal
CINEMA_PROCINAL_FEED_URL=
CINEMA_PROCINAL_FEED_TOKEN=

# Royal Films
CINEMA_ROYALFILMS_FEED_URL=
CINEMA_ROYALFILMS_FEED_TOKEN=
# CINEMA_ROYALFILMS_HOSTS=royal-films.com

# Caché y fallos (opcionales; valores por defecto)
# CINEMA_CACHE_TTL_MINUTES=20
# CINEMA_ERROR_BACKOFF_MINUTES=5
# CINEMA_PROVIDER_TIMEOUT_SECONDS=20
